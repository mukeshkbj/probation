# Copy to .env and fill in. Never commit .env.
SWITCH_BASE_URL=http://localhost:8000       # Switch server address shown in Switch Console (Settings > System status)
SWITCH_REGISTRATION_KEY=                    # for scripts/register_warden.py only (Settings > API keys)
WARDEN_AGENT_ID=                            # printed by scripts/register_warden.py
WARDEN_API_KEY=                             # printed by scripts/register_warden.py (shown once)
WARDEN_NAME=warden
TEAM_ROOM_ID=                               # from `make spike-rooms` or !room-url
SPONSOR_HANDLES=mukesh                      # comma list of users allowed to approve/reject
CANDIDATES=scout,rookie                     # agent names (Switch agent handles)
PROBATION_DB=./warden.db
PERSONNEL_DIR=./personnel
SHIM_PORT=8787
REDTEAM_MODE=fallback                       # "flintai" or "fallback"
JUDGE_MODEL=                                # optional LLM judge (ANTHROPIC_API_KEY); fallback = rule-based judge

# Optional
# SPOTCHECK_RATE=0                          # 0..1 chance that a routed task becomes a mystery-shopper probe
# REPLY_TIMEOUT=120                         # seconds Warden waits for a candidate's reply
# PROBATION_ROOM_SCOUT=                     # fallback room ids if create_room is refused (spike 4)
# PROBATION_ROOM_ROOKIE=

# Red-team (optional tuning; see redteam/FLINTAI_NOTES.md)
# REDTEAM_CLI=switch-trust                  # or flintai; default: whichever is installed
# REDTEAM_EVALS=eval-probation-pii,eval-probation-secret
# REDTEAM_TIMEOUT=900
# REDTEAM_PROMPT_TIMEOUT=120
# PROBATION_ROOM_SCOUT=                     # fallback rooms if create_room is refused
# PROBATION_ROOM_ROOKIE=
